{
  "name": "x",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/GTMinions/x.git"
  },
  "description": "Multi-tenant product demo platform with a per-product deep-research site engine. Each product is an isolated demo that also carries a first-class research site (entities, depth ladder, topology, citations).",
  "scripts": {
    "dev": "next dev -p 4000 -H 127.0.0.1",
    "prebuild": "npx tsx scripts/product-db.ts pull --all; npx tsx scripts/product-db.ts stubs --all",
    "build": "npx tsx scripts/validate-content.ts && npx tsx scripts/validate-copy.ts && npx tsx scripts/validate-slides.ts && npx tsx scripts/validate-coherence.ts && npx tsx scripts/validate-voice.ts && npx tsx scripts/build-topology-history.ts && npx tsx scripts/build-topology.ts && npx tsx scripts/build-search-index.ts && next build",
    "start": "next start -p 4000 -H 127.0.0.1",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "research:validate": "npx tsx scripts/validate-content.ts && npx tsx scripts/validate-slides.ts && npx tsx scripts/validate-coherence.ts",
    "research:voice": "npx tsx scripts/validate-voice.ts",
    "research:sources": "npx tsx scripts/validate-sources.ts",
    "research:crosscheck": "npx tsx scripts/validate-cross-entity.ts",
    "research:within": "npx tsx scripts/validate-within-entity.ts",
    "research:audit": "npx tsx scripts/audit-depth.ts",
    "research:history": "npx tsx scripts/build-topology-history.ts",
    "research:topology": "npx tsx scripts/build-topology.ts",
    "research:index": "npx tsx scripts/build-search-index.ts",
    "wishes": "npx tsx scripts/wishes.ts",
    "tokens": "npx tsx scripts/measure-tokens.ts",
    "slides:validate": "npx tsx scripts/validate-slides.ts",
    "research:coherence": "npx tsx scripts/validate-coherence.ts",
    "product:db": "npx tsx scripts/product-db.ts",
    "platform:selftest": "npx tsx scripts/selftest-memberships.ts",
    "db:backup": "npx tsx scripts/backup-db.ts",
    "db:backup:check": "npx tsx scripts/backup-db.ts --check",
    "worker": "npx tsx scripts/worker.ts",
    "tiers": "npx tsx scripts/tiers.ts",
    "spin": "pnpm install && next dev -p 4000",
    "copy:validate": "npx tsx scripts/validate-copy.ts",
    "copy:codemod": "npx tsx scripts/codemod-copy.ts",
    "product:demo:export": "npx tsx scripts/product-db.ts export inference-economics demo/inference-economics.json",
    "game:embed": "npx tsx scripts/embed-game.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
